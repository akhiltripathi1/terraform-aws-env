# Copy this to terraform.tfvars and adjust as needed.

aws_region     = "ap-south-1"
project_name   = "demo-env"
environment    = "dev"

vpc_cidr              = "10.0.0.0/16"
az_count              = 2
public_subnet_cidrs   = ["10.0.0.0/24", "10.0.1.0/24"]
private_subnet_cidrs  = ["10.0.10.0/24", "10.0.11.0/24"]

instance_type  = "t3.micro"
instance_count = 2

# Leave null to disable SSH entirely and rely on SSM Session Manager instead.
key_pair_name    = null
allowed_ssh_cidr = "203.0.113.10/32" # replace with your own IP/32 if you set key_pair_name
